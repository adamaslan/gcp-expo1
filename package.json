{
  "name": "gcp3-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "./scripts/dev-all.sh",
    "start": "expo start",
    "expo-only": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "smoke": "npx ts-node scripts/smoke-backends.ts",
    "gen:types": "npx openapi-typescript $EXPO_PUBLIC_GCP3_BACKEND_URL/openapi.json -o lib/clients/gcp3.types.ts && npx openapi-typescript $EXPO_PUBLIC_HOLDFOLD_BACKEND_URL/openapi.json -o lib/clients/holdfold.types.ts"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@clerk/mcp-tools": "^0.5.0",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
