{
  "expo": {
    "name": "NuWrrrld Financial",
    "slug": "nuwrrrld-financial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "nuwrrrld",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nuwrrrld.financial",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Not used.",
        "NSLocationWhenInUseUsageDescription": "Not used."
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": "$(GOOGLE_REVERSED_CLIENT_ID)"
        }
      }
    },
    "android": {
      "package": "com.nuwrrrld.financial",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.INTERNET", "android.permission.RECEIVE_BOOT_COMPLETED"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "nuwrrrld-financial"
      }
    }
  }
}
